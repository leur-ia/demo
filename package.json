{
  "name": "leuria-demo",
  "private": true,
  "description": "Leuria's public demos: websites whose AI features run on the visitor's own AI.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "shop": "pnpm --filter @leuria-demo/shop dev",
    "notes": "pnpm --filter @leuria-demo/notes dev",
    "dex": "pnpm --filter @leuria-demo/dex dev",
    "build": "node scripts/build-showroom.mjs",
    "serve": "node scripts/serve-static.mjs",
    "check": "pnpm -r check"
  }
}
